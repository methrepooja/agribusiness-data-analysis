        "import pandas as pd\n",
        "\n",
        "# Load the dataset from the CSV file\n",
        "crop = pd.read_csv(\"crop.csv\")\n",
        "\n",
        "crop_clean = crop.dropna(subset=[\"Production\"]).copy()\n",
        "crop_clean = crop_clean.drop_duplicates()\n",
        "\n",
        "crop_clean.to_csv(\"crop_cleaned.csv\", index=False)"
